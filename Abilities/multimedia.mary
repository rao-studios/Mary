    "operatingPolicy" : {
      "defaultSupportingAbilities" : [
        "window-management"
      ],
      "guardrails" : [
        "Transport verbs address the player, never a named application's window — a media key reaches whatever holds the system's now-playing role.",
        "Never report what is playing from memory; a stale track is worse than no answer.",
        "Opening a catalog result is not playing it; say what was opened."
      ],
      "phases" : [
        "resolve-player",
        "read-transport",
        "act-once",
        "verify-outcome"
      ],
      "stopConditions" : [
        "user stop",
        "no player running",
        "permission denial"
      ],
      "successSignals" : [
        "the transport reports the state the request asked for",
        "the player that answered is the one the user meant"
      ]
    },
