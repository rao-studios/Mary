      "defaultSupportingAbilities" : [

      ],
      "guardrailCategories" : [
        "staleState"
      ],
      "guardrails" : [
        "Never report a caller, a callee or a line number from memory; a trace is only as true as the read that produced it.",
        "Unseen is not absent: a name this grammar cannot capture is untraced, never uncalled.",
        "Follow the work; never bring a file forward to look at it."
      ],
      "phases" : [
        "locate-unit",
        "read-unit",
        "trace-neighbourhood",
        "report-with-bearings"
      ],
      "stopConditions" : [
        "user stop",
        "no unit in front",
        "no project to walk",
        "permission denial"
      ],
      "successSignals" : [
        "the unit reported is the one the cursor is in",
