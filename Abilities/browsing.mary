    ],
    "applications" : [

    ],
    "id" : "browsing",
    "operatingPolicy" : {
      "defaultSupportingAbilities" : [
        "window-management"
      ],
      "guardrailCategories" : [

      ],
      "guardrails" : [
        "Say the site, never the address — a URL read aloud is unusable as speech.",
        "Drive a page's player by pressing the control the page draws, never a site's keyboard shortcut and never the system media keys, which reach whatever holds now-playing rather than this tab.",
        "Revealing a player's controls moves the pointer over the page; put it back.",
        "Prove a navigation by the page's own address or title changing, never by the act returning.",
        "Two browsers open and nothing said is a question, not a coin flip.",
        "Read the page, act, then read it again — a step with no receipt is reported as not landed, never as done.",
        "A search query is typed into the browser's own address bar, so it uses whichever search they have set up; no address is written for them.",
        "When a phrase fits more than one thing on the page, name the rivals and stop.",
        "A name nothing wrote — \"button 4\" — is a position, and it is offered as one."
      ],
      "phases" : [
        "resolve-browser",
        "read-shell",
        "perceive-page",
        "resolve-target",
        "act-once",
        "verify-outcome"
      ],
      "stopConditions" : [
        "user stop",
        "no browser running",
        "permission denial"
      ],
      "successSignals" : [
        "the page's address or title changed",
        "the player's state moved the way it was asked to"
      ]
    },
    "paradigm" : "discipline",
    "routing" : {
