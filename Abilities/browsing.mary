    ],
    "id" : "browsing",
    "operatingPolicy" : {
      "defaultSupportingAbilities" : [
        "window-management"
      ],
      "guardrailCategories" : [

      ],
      "guardrails" : [
        "Say the site, never the address — a URL read aloud is unusable as speech.",
        "Drive a page's player by pressing the control the page draws, never a site's keyboard shortcut and never the system media keys, which reach whatever holds now-playing rather than this tab.",
        "Revealing a player's controls moves the pointer over the page; put it back.",
        "Prove a navigation by the page's own address or title changing, never by the act returning.",
        "Two browsers open and nothing said is a question, not a coin flip."
      ],
      "phases" : [
        "resolve-browser",
        "read-shell",
        "perceive-page",
        "act-once",
        "verify-outcome"
      ],
      "stopConditions" : [
        "user stop",
        "no browser running",
        "permission denial"
      ],
      "successSignals" : [
        "the page's address or title changed",
        "the player's state moved the way it was asked to"
      ]
    },
    "paradigm" : "discipline",
    "routing" : {
