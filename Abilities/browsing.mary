    ],
    "id" : "browsing",
    "operatingPolicy" : {
      "defaultSupportingAbilities" : [
        "window-management"
      ],
      "guardrails" : [
        "Operate only in a browser that is already running; opening one is the user's move, not Mary's.",
        "Act in the tab that is already open; a new tab is for a new destination.",
        "Hold addresses, speak site names — reading a URL aloud is noise, and reading a long one aloud is noise for twenty seconds.",
        "Never invent a path or a query; open only what the user actually said.",
        "Never type into page content to navigate, and never answer a page's own dialog for the user.",
        "A page that has not been exposed to Accessibility yet is not an empty page; say which it is."
      ],
      "phases" : [
        "resolve-browser",
        "read-what-is-open",
        "act-once",
        "verify-outcome"
      ],
      "stopConditions" : [
        "user stop",
        "no browser running",
        "two browsers and nothing said which",
        "permission denial"
      ],
      "successSignals" : [
        "the tab that is showing is the one the request named",
        "the browser that answered is the one the user meant"
      ]
    },
