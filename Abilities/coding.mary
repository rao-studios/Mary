    ],
    "id" : "coding",
    "operatingPolicy" : {
      "defaultSupportingAbilities" : [
        "window-management"
      ],
      "guardrailCategories" : [
        "domainMismatch",
        "unscopedTarget"
      ],
      "guardrails" : [
        "Never type prose into a code surface; the writing Ability owns prose.",
        "A build, run or test is the editor's own command, never a synthesized edit.",
        "Never act on a project the user did not name or focus."
      ],
      "phases" : [
        "resolve-workspace",
        "revalidate-identity",
        "invoke-once",
        "verify-outcome"
      ],
      "stopConditions" : [
        "user stop",
        "workspace mismatch",
        "focus loss",
        "permission denial"
      ],
      "successSignals" : [
        "the editor accepted the command",
        "the workspace that ran is the one named"
      ]
    },
    "paradigm" : "discipline",
    "routing" : {
